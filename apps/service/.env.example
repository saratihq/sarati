ENVIRONMENT=development
PORT=8001
# Public base URL that webhook trigger URLs are minted from. Empty → http://localhost:<PORT>.
PUBLIC_BASE_URL=
FRONTEND_URL=http://localhost:3100
# trace | debug | info | warn | error. Empty → info.
LOG_LEVEL=
# How long a run may stay in flight before it is declared dead and marked errored. 0 disables.
RUN_MAX_DURATION_SECONDS=3600
# Schedule and polling trigger cadence. 0 disables; pg-boss will not go below 60.
TRIGGER_POLL_INTERVAL_SECONDS=60
PGBOSS_ENABLED=true
# oss | cloud
EDITION=oss

# Run `pnpm db:init` against a FRESH database — the service refuses to boot against one
# that is behind the code rather than corrupting it.
DATABASE_URL=postgresql://orchestr:orchestr@localhost:5432/orchestr_svc

# ── Auth — fill in one. With all of them empty, email and password is the way in. ──
OIDC_ISSUER=
OIDC_JWKS_URL=
OIDC_AUDIENCE=
CLERK_ISSUER=
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3100
# Empty → on, and off whenever CLERK_ISSUER is set. Set explicitly to override.
LOCAL_AUTH_ENABLED=
# Fixed test user, no token needed. Refused in production.
MOCK_AUTH=false

# ── Managed connections (Composio) ──
# The API KEY is not here: add it in Settings → Platform keys, where it takes effect without a
# restart. Empty = inert: the built-in SDK actions and bring-your-own auth still work.
COMPOSIO_BASE_URL=https://backend.composio.dev
# Extra app slugs forced onto the Composio execution fallback (comma or space separated).
COMPOSIO_FALLBACK_APPS=
# The webhook signing secret is not here either — it is the same Composio project's credential,
# so it is set per user or per organization in Settings → Platform keys beside the API key.

# Contributors: the *.live.spec.ts suites hit Composio for real and skip unless COMPOSIO_LIVE=1
# with COMPOSIO_API_KEY (a test-harness input, NOT a setting the running service reads) and,
# per rail, a connected account id and its sandbox user.
# `pnpm check` expects these unset.
#COMPOSIO_LIVE=1
#COMPOSIO_LIVE_GMAIL_ACCOUNT=
#COMPOSIO_LIVE_GMAIL_USER=
#COMPOSIO_LIVE_SLACK_ACCOUNT=
#COMPOSIO_LIVE_SLACK_USER=
#COMPOSIO_LIVE_ASANA_ACCOUNT=
#COMPOSIO_LIVE_ASANA_USER=

# ── Web and security ──
CORS_ORIGINS=http://localhost:3100
SECRET_KEY=change-me-in-production
# Encrypts stored credentials at rest. Required in production, and losing it makes them
# unrecoverable.
FERNET_KEY=
# Container only: where the entrypoint generates and reads the SECRET_KEY + FERNET_KEY pair
# on first boot. Must sit on a volume that outlives the container.
#SARATI_SECRETS_FILE=/data/secrets.env
TRUST_PROXY_HEADERS=false
MAX_REQUEST_BODY_BYTES=2097152
# Hosts the http.send_request SSRF guard lets back in — it blocks private, loopback,
# link-local and cloud-metadata targets. The name belongs to @sarati/actions-sdk, which reads it.
ORCHESTR_HTTP_ALLOWED_HOSTS=
# Global bucket per client; route-level limits layer on top.
THROTTLE_LIMIT=60
THROTTLE_TTL_MS=60000

# ── Durable execution (DBOS) ──
# Crash-resume: a killed or redeployed worker resumes in-flight runs instead of orphaning
# them. Required in production — boot fails closed without it. Needs its own Postgres system
# database, which it creates itself (defaults to <DATABASE_URL db>_dbos).
DBOS_ENABLED=false
DBOS_SYSTEM_DATABASE_URL=
# Recovery identity: DBOS only recovers runs whose recorded version matches the launching
# process. Hold it stable across deploys — never the git SHA — or a deploy strands the runs
# its predecessor left in flight. Empty → a stable in-code default.
DBOS_APP_VERSION=
# Per-replica recovery scope. Empty → 'local', which is right for a single instance.
DBOS_EXECUTOR_ID=

# ── Bring-your-own OAuth ──
# Register an OAuth app per provider. Well-known providers (google, slack, …) already know
# their authorize and token URLs, so client id and secret are enough; for any other also set
# _AUTH_URL and _TOKEN_URL. Optional per provider: _SCOPES, _PKCE=false.
#OAUTH_GOOGLE_CLIENT_ID=
#OAUTH_GOOGLE_CLIENT_SECRET=
#OAUTH_SLACK_CLIENT_ID=
#OAUTH_SLACK_CLIENT_SECRET=
# Where providers redirect after consent; must match each app's registered redirect URI.
# Empty → <FRONTEND_URL>/integrations/callback.
OAUTH_REDIRECT_URI=http://localhost:3100/integrations/callback
