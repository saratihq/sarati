# Runtime
ENVIRONMENT=development
PORT=8001
# This service's public base URL — webhook trigger URLs are minted from it.
# Empty → http://localhost:<PORT> (dev).
PUBLIC_BASE_URL=
# Frontend origin — used to derive the OAuth callback redirect when
# OAUTH_REDIRECT_URI is unset. (:3100 is the Next dev server.)
FRONTEND_URL=http://localhost:3100
# Log level (pino): trace | debug | info | warn | error. Empty → info.
LOG_LEVEL=
# Max wall-clock a run may stay in-flight before the durability reaper (B8, ADR 0035)
# declares it dead (crash/kill/deploy) and marks it errored, so runs never hang.
# Default 3600 (1h); 0 disables the reaper.
RUN_MAX_DURATION_SECONDS=3600
# Runtime trigger poll cadence in seconds — schedule/polling triggers (0 disables;
# 1-min pg-boss floor).
TRIGGER_POLL_INTERVAL_SECONDS=60

# Postgres. Run `pnpm db:init` against a FRESH database to create the schema — the service
# refuses to boot against one that is behind the code rather than corrupting it.
DATABASE_URL=postgresql://orchestr:orchestr@localhost:5432/orchestr_svc

# ── Auth — pick one strategy (leave the others empty to disable them) ──
# OIDC (self-host): bring your own IdP. Empty issuer = inert.
OIDC_ISSUER=
OIDC_JWKS_URL=
OIDC_AUDIENCE=
# Clerk (hosted-cloud path). Empty CLERK_ISSUER rejects Clerk bearer tokens.
CLERK_ISSUER=
CLERK_SECRET_KEY=
# Must include the client origin (:3100 for the Next dev server).
CLERK_AUTHORIZED_PARTIES=http://localhost:3100
# Dev/test only — bypass auth with a fixed test user. NEVER enable in production.
MOCK_AUTH=false

# Email + password sign-in, the self-host way in. Defaults ON, and OFF whenever CLERK_ISSUER
# is set, so a Clerk deployment never grows a second front door. Set explicitly to override.
LOCAL_AUTH_ENABLED=

# Open-core edition (oss | cloud)
EDITION=oss

# ── Managed connections (Composio) ──
# Composio project API key — enables the managed one-click connect + execution rail
# (~105 apps / 6k actions) on top of the built-in SDK actions. Empty = inert; the
# SDK rail + bring-your-own auth still work without it (self-host default).
COMPOSIO_API_KEY=
COMPOSIO_BASE_URL=https://backend.composio.dev
# Extra app slugs (comma/space list) forced onto the Composio execution fallback,
# on top of the built-in transport-gap set. Empty by default.
COMPOSIO_FALLBACK_APPS=
# Composio project WEBHOOK signing secret (ADR 0046) — verifies the trigger-event
# deliveries Composio POSTs to /api/hooks/composio (Svix HMAC-SHA256). Get it from
# the Composio dashboard (Settings → Webhooks), where you ALSO set the project
# webhook URL to https://<your-host>/api/hooks/composio. Empty → the intake fails
# closed (no trigger events fire); the catalog + subscribe still work. Required to
# actually RECEIVE Composio trigger events.
COMPOSIO_WEBHOOK_SECRET=

# ── Composio live tests — CONTRIBUTORS ONLY, never a deployment setting ──
# The *.live.spec.ts suites hit Composio for real, so they are skipped unless
# COMPOSIO_LIVE=1 plus COMPOSIO_API_KEY and the ids for the rail under test. Each pair
# is a connected account id and the sandbox user it belongs to. Leave these unset: with
# COMPOSIO_LIVE unset the suites skip, which is what `pnpm check` expects.
#COMPOSIO_LIVE=1
#COMPOSIO_LIVE_GMAIL_ACCOUNT=
#COMPOSIO_LIVE_GMAIL_USER=
#COMPOSIO_LIVE_SLACK_ACCOUNT=
#COMPOSIO_LIVE_SLACK_USER=
#COMPOSIO_LIVE_ASANA_ACCOUNT=
#COMPOSIO_LIVE_ASANA_USER=

# ── Web / security ──
# Browser origins allowed to call this API. Must include the client (:3100).
CORS_ORIGINS=http://localhost:3100
SECRET_KEY=change-me-in-production
# Encrypts stored OAuth/API-key credentials at rest (Fernet). REQUIRED in production.
FERNET_KEY=
# Container only: where docker/entrypoint.sh generates and reads the SECRET_KEY +
# FERNET_KEY pair on first boot. Must sit on a volume that outlives the container.
#SARATI_SECRETS_FILE=/data/secrets.env
TRUST_PROXY_HEADERS=false
MAX_REQUEST_BODY_BYTES=2097152
# SSRF guard: the http.send_request action blocks private/loopback/link-local/
# cloud-metadata targets. Comma-separated hosts here are opted back in (for a
# self-host workflow that must call an internal service). Empty = block all internal.
# Named by @sarati/actions-sdk, which reads it — renaming it here alone silently
# disables the opt-in. The rename belongs in that package's repo first.
ORCHESTR_HTTP_ALLOWED_HOSTS=
# Global rate-limit bucket (per client). Route-level limits layer on top.
THROTTLE_LIMIT=60
THROTTLE_TTL_MS=60000

# Jobs (pg-boss)
PGBOSS_ENABLED=true

# DBOS durable-execution runtime — runs crash-resume (a killed/redeployed worker
# resumes in-flight runs instead of orphaning them). REQUIRED in production (boot
# fails closed if ENVIRONMENT=production and this is not true); the code default
# stays off so bare/CI runs use the simple in-process path. It needs its own
# Postgres system database (defaults to <DATABASE_URL db>_dbos) — DBOS CREATES it
# automatically on launch, so no manual setup beyond the Postgres role being allowed
# to create databases. (B7)
DBOS_ENABLED=false
DBOS_SYSTEM_DATABASE_URL=
# B9: recovery identity. DBOS only recovers in-flight runs whose recorded version
# matches the launching process. Empty → a STABLE in-code default ('orchestr-1').
# REQUIRED in production: set it to a stable value and HOLD it across deploys (never
# the git SHA) so a routine deploy recovers its predecessors. Bump only on a
# backward-incompatible interpreter change.
DBOS_APP_VERSION=
# Executor id (per-instance recovery scope). Empty → DBOS's stable 'local' (fine for
# a single instance). A multi-instance deploy sets a DISTINCT stable id per replica.
DBOS_EXECUTOR_ID=

# ── Bring-your-own OAuth (self-managed connections, ADR 0042) ──
# Register an OAuth app per provider, then set its client id/secret here. Well-known
# providers (google, slack, …) already know their authorize/token URLs; supply
# CLIENT_ID + CLIENT_SECRET only. For any other provider also set _AUTH_URL/_TOKEN_URL.
# Optional per-provider: _SCOPES (space/comma list, overrides the default), _PKCE=false.
# (Users can also bring their own client per-connection from the UI — this env path is
# the deployment-wide default.)
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_SLACK_CLIENT_ID=
# OAUTH_SLACK_CLIENT_SECRET=
# Where providers redirect after consent — a FE route that forwards ?code&state to
# POST /api/connections/oauth/callback. Empty → <FRONTEND_URL>/integrations/callback.
# Must match each app's registered redirect URI.
OAUTH_REDIRECT_URI=http://localhost:3100/integrations/callback
