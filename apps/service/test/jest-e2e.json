{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "..",
  "testEnvironment": "<rootDir>/test/support/no-egress-environment.ts",
  "globalTeardown": "<rootDir>/test/support/no-egress-teardown.ts",
  "maxWorkers": 1,
  "setupFiles": ["<rootDir>/test/support/test-env.ts"],
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/tsconfig.json"
      }
    ]
  },
  "testTimeout": 20000,
  "testPathIgnorePatterns": [
    "/node_modules/",
    "/.claude/",
    "/dist/"
  ]
}
