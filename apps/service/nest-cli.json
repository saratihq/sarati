{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.build.json",
    "assets": [
      { "include": "providers/piece-runner/runner-main.js" },
      { "include": "providers/piece-runner/managed-transport.js" }
    ],
    "watchAssets": true
  }
}
