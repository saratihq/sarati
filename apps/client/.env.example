# ⚠ BUILD-TIME: every NEXT_PUBLIC_* below is INLINED into the bundle by
# `next build` — baked at build time, not read at runtime. They MUST be present
# when you build (locally these come from .env.local; on Railway set them as
# service variables BEFORE the build runs). A production build with any required
# NEXT_PUBLIC_* unset FAILS LOUD (see src/lib/config.ts) instead of silently
# shipping a localhost default. CLERK_SECRET_KEY is a server-only runtime var
# (not inlined) and must NOT be exposed with a NEXT_PUBLIC_ prefix.

# Backend API base — @sarati/service. "/api" is appended in code.
NEXT_PUBLIC_API_URL=http://localhost:8001

# AI composer base — @sarati/agent. "/api" is appended in code.
NEXT_PUBLIC_AGENT_URL=http://localhost:8010

# Clerk publishable key (public) — consumed by <ClerkProvider> in the root layout.
# OPTIONAL, unlike the URLs above: leave both Clerk vars empty to run without Clerk, and the app
# signs in with the service's email + password instead (ADR 0054 — the self-host front door).
# Running `next dev` with no key also wants CLERK_KEYLESS_DISABLED=true, or Clerk auto-provisions
# a throwaway dev instance.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# required by @clerk/nextjs middleware/server when Clerk is in use — get from Clerk dashboard
CLERK_SECRET_KEY=

# Headless custom flows live at these app routes (not Clerk hosted UI)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
