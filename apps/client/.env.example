# Every NEXT_PUBLIC_* below is inlined into the bundle by `next build`, so it has to be set
# before the build runs, not at container start. A production build missing a required one
# fails loud (src/lib/config.ts) instead of shipping a localhost default.

# @sarati/service. "/api" is appended in code.
NEXT_PUBLIC_API_URL=http://localhost:8001
# @sarati/agent, the AI composer. "/api" is appended in code.
NEXT_PUBLIC_AGENT_URL=http://localhost:8010

# Clerk is optional: leave these empty to sign in with email and password instead.
# CLERK_SECRET_KEY is server-only — never give it a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
# Without it, `next dev` with no publishable key auto-provisions a throwaway Clerk instance.
CLERK_KEYLESS_DISABLED=true
