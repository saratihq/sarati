ENVIRONMENT=development
PORT=8010
CORS_ORIGINS=http://localhost:3100

# @sarati/service, which backs the composer's tools.
WORKFLOW_SERVICE_URL=http://localhost:8001
# Settings → API keys in the client, or POST /api/api-keys.
WORKFLOW_SERVICE_API_KEY=ork_...

# Unset boots with the composer disabled rather than crash-looping — /api/composer/status
# reports why and the endpoints answer 503.
ANTHROPIC_API_KEY=sk-ant-...
COMPOSER_MODEL=claude-opus-4-8

# Durable composer threads, optional: the same Postgres @sarati/service uses, whose schema
# ships there. Unset → memory-only sessions that do not survive a restart.
#DATABASE_URL=postgresql://orchestr:orchestr@localhost:5432/orchestr_svc

# ── Caller auth on /api/composer/*. The verified bearer is forwarded to @sarati/service, so
# runs execute as the user. With neither path set the composer is disabled, never served
# unauthenticated. ──
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://localhost:3100
# Local email and password sessions: the SAME SECRET_KEY @sarati/service uses.
#SECRET_KEY=
#LOCAL_AUTH_ENABLED=true
# Local dev only, refused in production. Needs WORKFLOW_SERVICE_API_KEY as the tool-call fallback.
#MOCK_AUTH=true
