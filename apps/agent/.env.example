# @sarati/agent — local configuration.
# For a production deploy set ENVIRONMENT=production; see README.md for the full
# required-env table. Hosts that inject PORT want it left unset there.
ENVIRONMENT=development
PORT=8010

# Editor origins allowed to open composer streams.
CORS_ORIGINS=http://localhost:3100

# @sarati/service (the tools' backend).
WORKFLOW_SERVICE_URL=http://localhost:8001

# Durable composer threads (optional): the same Postgres @sarati/service
# uses — schema ships there (db/migrations/007_composer_threads.sql). Unset =
# memory-only sessions (transcripts do not survive restarts/TTL).
#DATABASE_URL=postgresql://orchestr:orchestr@localhost:5432/orchestr_svc
# Create via the running stack: POST /api/api-keys (or Settings → API keys in the client).
WORKFLOW_SERVICE_API_KEY=ork_...

# Claude Agent SDK. Unset boots with the composer DISABLED (the service still
# starts; /api/composer/status reports why and the endpoints 503) — a stack
# that ships this service by default must not crash-loop without a key.
ANTHROPIC_API_KEY=sk-ant-...
COMPOSER_MODEL=claude-opus-4-8

# Caller auth on /api/composer/*, over two independent paths. The verified
# bearer is forwarded to @sarati/service (runs execute AS the user).
# MOCK_AUTH=true bypasses both for local dev (refused in production) — it needs
# WORKFLOW_SERVICE_API_KEY as the tool-call fallback. NONE set: the composer is
# DISABLED, never served unauthenticated.

# Path 1 — Clerk: session JWTs verified networklessly against the instance JWKS.
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://localhost:3100

# Path 2 — local email + password sessions (@sarati/service ADR 0054), which
# is how a self-host signs in. Must be the SAME value @sarati/service uses;
# its docker/entrypoint.sh generates one onto the shared data volume, so
# compose has to pass that same value here. On by default when CLERK_ISSUER is
# unset, off when it is set — LOCAL_AUTH_ENABLED overrides either way.
#SECRET_KEY=...
#LOCAL_AUTH_ENABLED=true

#MOCK_AUTH=true
