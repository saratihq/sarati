{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sarati-docs",
  "compatibility_date": "2026-08-11",
  "main": "./worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Starlight emits a real 404 page; without this a bad URL would serve index.html.
    "not_found_handling": "404-page",
    // Only videos need byte ranges; everything else stays a free static hit.
    "run_worker_first": ["/shots/*.mp4", "/shots/*.webm"]
  }
}
