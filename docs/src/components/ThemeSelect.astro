---
/* Overrides Starlight's three-option select with the website's two-state sun/moon toggle. */
---

<button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch theme">
  <svg
    class="icon-sun"
    viewBox="0 0 24 24"
    width="16"
    height="16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4.2"></circle><path
      d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4"
    ></path>
  </svg>
  <svg
    class="icon-moon"
    viewBox="0 0 24 24"
    width="16"
    height="16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20 14.2A8.2 8.2 0 0 1 9.8 4a8.4 8.4 0 1 0 10.2 10.2z"></path>
  </svg>
</button>

<script is:inline>
  (() => {
    const KEY = 'starlight-theme';
    const btn = document.currentScript.previousElementSibling;
    const label = () =>
      btn.setAttribute(
        'aria-label',
        document.documentElement.dataset.theme === 'dark'
          ? 'Switch to light theme'
          : 'Switch to dark theme',
      );
    label();
    btn.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem(KEY, next);
      } catch {}
      label();
    });
  })();
</script>

<style>
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: 0.375rem;
    background: transparent;
    color: var(--sl-color-gray-3);
    cursor: pointer;
    transition:
      color 0.14s ease,
      background 0.14s ease;
  }
  .theme-toggle:hover {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-6);
  }
  .theme-toggle:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .icon-moon {
    display: none;
  }
  :global(:root[data-theme='dark']) .icon-sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .icon-moon {
    display: block;
  }
</style>
