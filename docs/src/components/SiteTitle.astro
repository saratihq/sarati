---
/* The wordmark goes home to the product site; a "Docs" pill keeps the docs index one click away. */
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<div class="site-title sl-flex">
  <a href="https://sarati.io" class="wordmark" translate="no">{siteTitle}</a>
  <a href={siteTitleHref} class="docs-pill">Docs</a>
</div>

<style>
  @layer starlight.core {
    .site-title {
      align-items: center;
      gap: 0.5rem;
      font-size: var(--sl-text-h4);
      font-weight: 600;
      white-space: nowrap;
      min-width: 0;
    }
    .wordmark {
      color: var(--sl-color-text-accent);
      text-decoration: none;
      overflow: hidden;
    }
    .wordmark:hover {
      text-decoration: underline;
    }
    .docs-pill {
      font-size: var(--sl-text-xs);
      font-weight: 600;
      line-height: 1;
      padding: 0.25rem 0.5rem;
      border-radius: 999px;
      color: var(--sl-color-gray-1);
      background: var(--sl-color-gray-6);
      text-decoration: none;
    }
    .docs-pill:hover {
      color: var(--sl-color-white);
      background: var(--sl-color-gray-5);
    }
  }
</style>
