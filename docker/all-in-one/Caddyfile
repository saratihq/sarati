# Same routing as the compose proxy, with the services on loopback instead of a network.
# Order matters: the composer's routes are a subpath of the service's `/api`.

# The client is the peer, or the right-most address a proxy in SARATI_TRUSTED_PROXIES vouches for; sent on alone.
{
	servers {
		trusted_proxies static {$SARATI_TRUSTED_PROXIES}
		trusted_proxies_strict
	}
	# Requests and their errors are logged as time, status and visitor alone: an address or header can carry an invite, webhook or sign-in secret.
	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>proto delete
				request>method delete
				request>host delete
				request>uri delete
				request>headers delete
				request>transfer_encoding delete
				request>tls delete
				bytes_read delete
				user_id delete
				duration delete
				size delete
				resp_headers delete
				write_error delete
				err_id delete
				err_trace delete
			}
		}
	}
}

:8080 {
	handle /api/composer/* {
		reverse_proxy 127.0.0.1:8010 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Service-to-service only: how agent-service reads the stored Anthropic key. No browser needs it.
	handle /api/internal/* {
		respond 404
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8001 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# The agent-facing MCP endpoint — streams, so no buffering.
	handle /mcp* {
		reverse_proxy 127.0.0.1:8001 {
			header_up X-Forwarded-For {client_ip}
			flush_interval -1
		}
	}

	handle {
		reverse_proxy 127.0.0.1:3000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	encode gzip
	log
}
