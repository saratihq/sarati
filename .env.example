# Copy to `.env` and fill in — or let the installer write it:
#   curl -fsSL https://get.sarati.io | bash

# Back these up with your data volume: losing FERNET_KEY makes stored credentials
# unrecoverable, and changing SECRET_KEY signs everyone out.
#   openssl rand -base64 36 | tr '+/' '-_'
SECRET_KEY=
FERNET_KEY=
POSTGRES_PASSWORD=

# Where this instance is reached — the browser, CORS and webhook URLs all follow it.
SARATI_URL=http://localhost:8080
SARATI_PORT=8080

# `latest`, or pin a release: 0.1.2
SARATI_VERSION=latest

# The Composio and Anthropic keys are NOT here — add them in Settings once Sarati is running.
