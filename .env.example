# Copy to `.env` and fill in — or let the installer generate it for you:
#   curl -fsSL https://get.sarati.io | bash

# Generated once per install. Back these up with your data volume:
# losing FERNET_KEY makes stored credentials unrecoverable, and rotating SECRET_KEY signs everyone out.
#   openssl rand -base64 36 | tr '+/' '-_'
SECRET_KEY=
FERNET_KEY=
POSTGRES_PASSWORD=

# Where this instance is reached. Change both if you put it behind a domain or another port —
# the URL is what the browser, CORS and any webhook you hand to a provider all use.
SARATI_URL=http://localhost:8080
SARATI_PORT=8080

# Pin a release instead of tracking latest, e.g. SARATI_VERSION=0.1.0
SARATI_VERSION=latest

# Optional. Without it the AI composer reports itself unavailable and everything else works.
ANTHROPIC_API_KEY=
