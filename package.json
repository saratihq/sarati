{
  "name": "sarati",
  "version": "0.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saratihq/sarati.git"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "pnpm -r --workspace-concurrency=1 check",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "dev": "pnpm --filter @sarati/client dev",
    "db:init": "pnpm --filter @sarati/service db:init",
    "db:migrate": "pnpm --filter @sarati/service db:migrate"
  }
}
